# URL publique du site principal
NEXT_PUBLIC_APP_URL=https://talentiques.com

# PayPal - reprendre les identifiants de l'application Live appropriée
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Supabase - stockage des commandes Store côté serveur
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Livraison e-mail Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=TalentiQues <resources@talentiques.com>
STORE_DELIVERY_RETRY_SECRET=
AFFILIATE_ADMIN_EMAIL=
AFFILIATE_ADMIN_SECRET=
AFFILIATE_SESSION_SECRET=

# Packages de livraison
# FR = package destiné aux acheteurs de la page française (FR + EN inclus)
STORE_TRACKER_PACKAGE_FR_URL=
STORE_ATS_PACKAGE_FR_URL=

# Préparés pour la future page anglaise (EN uniquement)
STORE_TRACKER_PACKAGE_EN_URL=
STORE_ATS_PACKAGE_EN_URL=

# Vrai timer de lancement - exemple de format ISO 8601 avec fuseau
